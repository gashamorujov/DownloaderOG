}

show_about() {
  echo -e "\e[036m DownloaderOG — telefonla Share (Paylaş) düyməsi ilə istənilən"
  echo -e "\e[036m videonu/musiqini Termux vasitəsilə yükləyən universal media"
  echo -e "\e[036m yükləyicisidir. Instagram, TikTok, Facebook və X/Twitter linkləri"
  echo -e "\e[036m avtomatik, ən yüksək keyfiyyətdə yüklənir. YouTube və digər"
  echo -e "\e[036m platformalarda yalnız real mövcud keyfiyyətlər göstərilir."
  echo -e "\e[036m Fayllar cut (kəsmə) ilə /storage/emulated/0/Download klasörünə"
  echo -e "\e[036m keçirilir və MediaStore-a qeydiyyata alınır. Uğurlu yükləmədən"
  echo -e "\e[036m sonra Termux avtomatik bağlanır.\e[0m"
  echo -e "\e[033m Daha çox məlumat: github.com/gashamorujov/DownloaderOG\e[0m"
  echo -e "\e[0m"
}

while true; do
  show_banner
  show_menu
  read choice

  case "$choice" in
    A|a)
      show_about
      continue
      ;;
    Q|q)
      echo -e "\e[032m DownloaderOG-dan çıxıldı. Sağ olun!\e[0m"
      exit 0
      ;;
    *)
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        if [ "$choice" -le "${#heights[@]}" ]; then
          h="${heights[$((choice-1))]}"
          do_download -f "bestvideo[height<=$h]+bestaudio/best[height<=$h]/best" --merge-output-format mp4 && exit_termux
        else
          do_download -x --audio-format mp3 --audio-quality 5 --embed-metadata --concurrent-fragments 8 -f 'bestaudio[ext=m4a]/bestaudio/best' && exit_termux
        fi
      else
        echo -e "\e[031m[!] Xəta: düzgün seçim daxil edin (1-$total, A və ya Q).\e[0m"
      fi
      ;;
  esac
done

exit 0
