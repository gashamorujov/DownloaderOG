show_menu() {
  echo -e "\e[036m╔════════════════════════════════════════════════════════════╗"
  echo -e "\e[032m║ ♚ Project Name : DownloaderOG™                           ║"
  echo -e "\e[032m║ ♚ Author       : Gasham Orujov                            ║"
  echo -e "\e[036m╠════════════════════════════════════════════════════════════╝"
  echo -e "\e[032m Başlıq: $title"
  echo -e "\e[036m╠═▶ [ SELECT A FORMAT ] ➳"
  local num=0
  echo -e "\e[036m MP4"
  if [ "$has_fallback" -eq 1 ]; then
    echo -e "\e[032m   1. Ən yaxşı keyfiyyət (MP4)"
  else
    for h in "${heights[@]}"; do
      num=$((num+1))
      echo -e "\e[032m   $num. ${h}p"
    done
  fi
  echo -e "\e[036m MP3"
  echo -e "\e[032m   $mp3_num. MP3 yüklə"
  echo -e "\e[036m   A. About"
  echo -e "\e[036m   Q. Çıxış"
  printf "\e[032m ╚═:➤ \e[0m "
}

show_about() {
  echo -e "\e[036m DownloaderOG — telefonla Share (Paylaş) düyməsi ilə istənilən"
  echo -e "\e[036m videonu/musiqini Termux vasitəsilə yükləyən universal media"
  echo -e "\e[036m yükləyicisidir. Instagram, TikTok, Facebook və X/Twitter linkləri"
  echo -e "\e[036m avtomatik, ən yüksək keyfiyyətdə yüklənir. YouTube və digər"
  echo -e "\e[036m platformalarda yalnız real mövcud keyfiyyətlər göstərilir."
  echo -e "\e[036m Fayllar cut (kəsmə) ilə /storage/emulated/0/Download/DownloaderOG"
  echo -e "\e[036m klasörünə keçirilir və MediaStore-a qeydiyyata alınır. Uğurlu yükləmədən"
  echo -e "\e[036m sonra Termux avtomatik bağlanır.\e[0m"
  echo -e "\e[0m"
}

while true; do
  show_banner
  show_menu
  read choice

  case "$choice" in
    A|a)
      show_about
      continue
      ;;
    Q|q)
      echo -e "\e[032m DownloaderOG-dan çıxıldı. Sağ olun!\e[0m"
      exit 0
      ;;
    *)
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$total" ]; then
        if [ "$has_fallback" -eq 1 ] && [ "$choice" -eq 1 ]; then
          do_download -f 'bestvideo*+bestaudio/best' --merge-output-format mp4 && exit_termux
        elif [ "$choice" -le "${#heights[@]}" ]; then
          h="${heights[$((choice-1))]}"
          do_download -f "bestvideo[height<=$h]+bestaudio/best[height<=$h]/best" --merge-output-format mp4 && exit_termux
        else
          do_download -x --audio-format mp3 --audio-quality 5 --embed-metadata -f 'bestaudio[ext=m4a]/bestaudio/best' && exit_termux
        fi
      else
        echo -e "\e[031m[!] Xəta: düzgün seçim daxil edin (1-$total, A və ya Q).\e[0m"
      fi
      ;;
  esac
done

exit 0
