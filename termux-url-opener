  echo "██╔════╝ ██╔══██╗██╔════╝██║  ██║██╔══██╗████╗ ████║"
  echo "██║  ███╗███████║███████╗███████║███████║██╔████╔██║"
  echo "██║   ██║██╔══██║╚════██║██╔══██║██╔══██║██║╚██╔╝██║"
  echo "╚██████╔╝██║  ██║███████║██║  ██║██║  ██║██║ ╚═╝ ██║"
