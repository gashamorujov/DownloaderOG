show_about() {
  echo -e "\e[036m DownloaderOG — telefonla Share (Paylaş) düyməsi ilə"
  echo -e "\e[036m istənilən videonu/musiqini Termux vasitəsilə yükləyən universal"
  echo -e "\e[036m media yükləyicisidir. yt-dlp mühərriki sayəsində YouTube, TikTok,"
  echo -e "\e[036m Instagram, Facebook, X, Reddit, Vimeo və yüzlərlə platformanı"
  echo -e "\e[036m dəstəkləyir. Yüklənən fayllar cut (kəsmə) ilə birbaşa"
  echo -e "\e[036m /storage/emulated/0/DownloaderOG klasörünə keçirilir.\e[0m"
  echo -e "\e[033m Daha çox məlumat: github.com/gashamorujov/DownloaderOG\e[0m"
  echo -e "\e[0m"
}

while true; do
  show_banner
  show_menu
  read choice

  case $choice in
    1)
      do_download -x --audio-format mp3 --audio-quality 0 -f 'bestaudio/best'
      exit_termux
      ;;
    2)
      do_download -f 'best[height<=360]/best'
      exit_termux
      ;;
    3)
      do_download -f 'best[height<=480]/best'
      exit_termux
      ;;
    4)
      do_download -f 'best[height<=720]/best'
      exit_termux
      ;;
    5)
      do_download -f 'best[height<=1080]/best'
      exit_termux
      ;;
    6)
      do_download -f 'best[height<=2160]/best'
      exit_termux
      ;;
    7)
      echo -e "\e[032m DownloaderOG-dan çıxıldı. Sağ olun!\e[0m"
      exit 0
      ;;
    A|a)
      show_about
      continue
      ;;
    *)
      do_download -f 'best[height<=2160]/best'
      exit_termux
      ;;
  esac
  break
done

exit 0
