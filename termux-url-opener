  echo -e "\e[32m"
  echo " ██████╗  █████╗ ███████╗██╗  ██╗ █████╗ ███╗   ███╗"
  echo "██╔════╝ ██╔══██╗██╔════╝██║  ██║██╔══██╗████╗ ████║"
  echo "██║  ███╗███████║███████╗███████║███████║██╔████╔██║"
  echo "██║   ██║██╔══██║╚════██║██╔══██║██╔══██║██║╚██╔╝██║"
  echo "╚██████╔╝██║  ██║███████║██║  ██║██║  ██║██║ ╚═╝ ██║"
  echo " ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝"
  echo -e "\e[0m"
  echo -e "\e[036m ==============================================================="
  echo -e "\e[036m == DownloaderOG — Termux üçün universal media yükləyici =="
  echo -e "\e[036m == YouTube • TikTok • Instagram • Facebook • X • Reddit • Vimeo =="
  echo -e "\e[0m"
}

show_menu() {
  echo -e "\e[036m╔════════════════════════════════════════════════════════════╗"
  echo -e "\e[032m║ ♚ Project Name : DownloaderOG™                           ║"
  echo -e "\e[032m║ ♚ Author       : Gasham Orujov                            ║"
  echo -e "\e[036m╠════════════════════════════════════════════════════════════╝"
  echo -e "\e[036m╠═▶ [ SELECT A FORMAT ] ➳"
  echo -e "\e[032m╠═▶ 1. Music MP3♫"
  echo -e "\e[032m╠═▶ 2. Video 360p"
  echo -e "\e[032m╠═▶ 3. Video 480p"
  echo -e "\e[032m╠═▶ 4. Video 720p"
  echo -e "\e[032m╠═▶ 5. Video 1080p"
  echo -e "\e[032m╠═▶ 6. Video 2160p"
