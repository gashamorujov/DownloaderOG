#!/data/data/com.termux/files/usr/bin/bash

# GASHAM DOWNLOADEROG
# Termux üçün universal media yükləyici
# Paylaş → avtomatik platforma aşkarlama → yükləmə → MediaStore → Termux bağlanması

# SETTINGS (istədiyiniz kimi dəyişə bilərsiniz)--------------
final_dir='/storage/emulated/0/Download'
og_dir="$final_dir/DownloaderOG"
tmp_dir="$HOME/.cache/downloaderog"
# Instagram/TikTok üçün (məcburi deyil): brauzerdə login olub cookies.txt
# yaradın və ~/.config/downloaderog/cookies.txt ünvanına kopyalayın.
cookies_file="$HOME/.config/downloaderog/cookies.txt"
# -----------------------------------------------------------

# Ümumi yükləmə bayraqları — platforma dəyişikliklərinə davamlılıq üçün
dl_flags=(
  --retries 10
  --fragment-retries 10
  --extractor-retries 5
  --socket-timeout 30
  --continue
  --concurrent-fragments 8
  --force-ipv4
  --remote-components ejs:github
)
[ -f "$cookies_file" ] && dl_flags+=(--cookies "$cookies_file")

# YouTube üçün JS mühərriki (yt-dlp indi bunu tələb edir)
js_flags=()
if command -v deno >/dev/null 2>&1; then
  js_flags+=(--js-runtimes deno)
elif command -v node >/dev/null 2>&1; then
  js_flags+=(--js-runtimes node)
fi

detect_platform() {
  case "$1" in
    *youtube.com*|*youtu.be*|*youtube-nocookie.com*|*music.youtube.com*) echo "youtube" ;;
    *instagram.com*|*instagr.am*) echo "instagram" ;;
    *tiktok.com*) echo "tiktok" ;;
    *facebook.com*|*fb.watch*|*fb.com*) echo "facebook" ;;
    *twitter.com*|*x.com*) echo "x" ;;
    *) echo "other" ;;
  esac
}

scan_media() {
  file="$1"
  if command -v termux-media-scan >/dev/null 2>&1; then
    # termux-media-scan bəzi Android versiyalarında (14+) əbədi asıla bilər —
    # buna görə maks. 10 saniyə gözləyirik, sonra broadcast ilə davam edirik
    termux-media-scan "$file" >/dev/null 2>&1 &
    scan_pid=$!
    waited=0
    while [ "$waited" -lt 10 ]; do
      kill -0 "$scan_pid" 2>/dev/null || break
      sleep 1
      waited=$((waited+1))
    done
    if kill -0 "$scan_pid" 2>/dev/null; then
      kill -9 "$scan_pid" 2>/dev/null
      wait "$scan_pid" 2>/dev/null
      echo -e "\e[033m[!] termux-media-scan vaxt aşımı — broadcast ilə yenidən cəhd olunur\e[0m"
      am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$file" >/dev/null 2>&1
    else
      wait "$scan_pid" 2>/dev/null
    fi
    echo -e "\e[036m[✓] MediaScanner: $(basename "$file") qeydiyyata alındı (Qalereya/pleyer)\e[0m"
  elif command -v am >/dev/null 2>&1; then
    am broadcast -a android.intent.action.MEDIA_SCANNER_SCAN_FILE -d "file://$file" >/dev/null 2>&1
    echo -e "\e[036m[✓] MediaScanner: $(basename "$file") qeydiyyata alındı (broadcast)\e[0m"
  else
    echo -e "\e[033m[!] Media qeydiyyatı üçün termux-api quraşdırın: pkg install termux-api\e[0m"
  fi
}

exit_termux() {
  echo -e "\e[036m Yükləmə tamamlandı — Termux bağlanır...\e[0m"
  sleep 2
  if command -v am >/dev/null 2>&1; then
    # 1) Rəsmi Termux mexanizmi: bütün sessiyalar öldürülür, service dayanır,
    #    Activity özü bağlanır — istifadəçi heç nə etmədən proqram tamamilə bağlanır
    am startservice -a com.termux.service_stop -n com.termux/.app.TermuxService >/dev/null 2>&1
    sleep 1
    # 2) Köməkçi: ev ekranına keçid (service_stop işləməsə)
    am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
    # 3) Son çarə: proqramı məcburi dayandır (icazə varsa)
    am force-stop com.termux >/dev/null 2>&1
  fi
  # 4) Son çarə: sessiya qabığını bağla ki, terminal açıq qalmasın
  ppid_comm="$(cat /proc/$PPID/comm 2>/dev/null)"
  case "$ppid_comm" in
    bash|sh|dash|mksh|zsh|login|fish) kill -9 "$PPID" >/dev/null 2>&1 ;;
  esac
  exit 0
}

move_unique() {
  src="$1"
  dir="$2"
  base="$(basename "$src")"
  if [[ "$base" == *.* ]]; then
    name="${base%.*}"
    ext="${base##*.}"
  else
    name="$base"
    ext=""
  fi
  dest="$dir/$base"
  n=1
  while [ -e "$dest" ]; do
    if [ -n "$ext" ]; then
      dest="$dir/$name ($n).$ext"
    else
      dest="$dir/$name ($n)"
    fi
    n=$((n+1))
  done
  mv -f "$src" "$dest"
  echo "$dest"
}

do_download() {
  mkdir -p "$tmp_dir" "$final_dir" "$og_dir"
  rm -f "$tmp_dir"/* 2>/dev/null
  yt-dlp "${dl_flags[@]}" "${js_flags[@]}" "$@" -o "$tmp_dir/%(title)s.%(ext)s" "$url"
  status=$?
  if [ "$status" -ne 0 ]; then
    echo -e "\e[031m[!] Yükləmə xətası — heç bir fayl tamamlanmadı.\e[0m"
    return "$status"
  fi
  moved=""
  found=""
  for f in "$tmp_dir"/*; do
    [ -e "$f" ] || continue
    found=1
    dest="$(move_unique "$f" "$final_dir")"
    moved="$(basename "$dest")"
  done
  if [ -z "$found" ]; then
    echo -e "\e[031m[!] Xəta: fayl tapılmadı — yükləmə tamamlanmadı.\e[0m"
    return 1
  fi
  if [ ! -f "$final_dir/$moved" ]; then
    echo -e "\e[031m[!] Xəta: fayl Download klasörünə yazıla bilmədi.\e[0m"
    return 1
  fi
  # Emal bitdi → Download → DownloaderOG (cut/move, kopya yoxdur)
  og_dest="$(move_unique "$final_dir/$moved" "$og_dir")"
  og_name="$(basename "$og_dest")"
  rm -f "$tmp_dir"/* 2>/dev/null
  if [ -f "$og_dir/$og_name" ]; then
    echo -e "\e[032m[✓] Fayl kəsildi (cut): $og_dir/$og_name\e[0m"
    scan_media "$og_dir/$og_name"
    return 0
  fi
  echo -e "\e[031m[!] Xəta: fayl DownloaderOG klasörünə yazıla bilmədi.\e[0m"
  return 1
}

show_error_hint() {
  case "$1" in
    instagram)
      echo -e "\e[033m[!] Instagram əksər linklər üçün giriş (login) tələb edir.\e[0m"
      echo -e "\e[033m    Həll: brauzerdə Instagram-a daxil olun, 'Get cookies.txt LOCALLY'\e[0m"
      echo -e "\e[033m    genişlənməsi ilə cookies.txt yaradın və onu:\e[0m"
      echo -e "\e[033m    ~/.config/downloaderog/cookies.txt ünvanına kopyalayın.\e[0m"
      echo -e "\e[033m    (Ətraflı: README.md → 'Instagram/TikTok üçün cookies')"
      ;;
    tiktok)
      echo -e "\e[033m[!] TikTok bəzən anti-bot yoxlaması və ya giriş tələb edir.\e[0m"
      echo -e "\e[033m    Həll: brauzerdə TikTok-a daxil olun, cookies.txt yaradın və onu:\e[0m"
      echo -e "\e[033m    ~/.config/downloaderog/cookies.txt ünvanına kopyalayın.\e[0m"
      echo -e "\e[033m    (Ətraflı: README.md → 'Instagram/TikTok üçün cookies')"
      ;;
  esac
}

check_requirements() {
  if ! command -v yt-dlp >/dev/null 2>&1; then
    echo -e "\e[031m[!] Xəta: yt-dlp quraşdırılmayıb. bash install.sh işlədin.\e[0m"
    wait_and_keep_open
  fi
}

meta_info() {
  mkdir -p "$tmp_dir"
  yt-dlp "${dl_flags[@]}" "${js_flags[@]}" --skip-download -j "$url" 2>"$tmp_dir/.meta_err" | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
title = (d.get("title") or "Bilinməyən başlıq").replace("\n", " ").replace("\t", " ")
heights = sorted({f.get("height") for f in d.get("formats") or []
                  if f.get("height") and (f.get("vcodec") or "") != "none"})
print(title)
print(",".join(str(h) for h in heights))
'
}

wait_and_keep_open() {
  echo -e "\e[033m Davam etmək üçün Enter basın...\e[0m"
  read -r _
  exit 0
}

url="$1"
if [[ -z "$url" ]]; then
  printf "\e[033m Video/audio linkini daxil edin: \e[0m"
  read -r url
fi
if [[ -z "$url" ]]; then
  echo -e "\e[031m Link daxil edilməyib. Çıxılır.\e[0m"
  exit 1
fi
check_requirements

# YouTube Shorts — avtomatik yükləmə (menyu göstərilmir)
if [[ "$url" == *"shorts"* ]]; then
  echo -e "\e[036m Short aşkarlandı — avtomatik yüklənir...\e[0m"
  if do_download -f 'bestvideo*+bestaudio/best' --merge-output-format mp4; then
    exit_termux
  else
    wait_and_keep_open
  fi
fi

platform="$(detect_platform "$url")"

# Instagram / TikTok / Facebook / X — avtomatik ən yüksək keyfiyyət (menyu yoxdur)
auto_download() {
  if [ "$platform" = "tiktok" ] && ! python3 -c "import curl_cffi" >/dev/null 2>&1; then
    echo -e "\e[033m[!] curl_cffi tapılmadı — TikTok impersonasiyası üçün vacibdir.\e[0m"
    echo -e "\e[033m    Həll: bash install.sh işlədin\e[0m"
  fi
  if do_download -f 'bestvideo*+bestaudio/best' --merge-output-format mp4; then
    return 0
  fi
  if [ "$platform" = "tiktok" ]; then
    echo -e "\e[033m[!] Web marşrutu uğursuz — TikTok mobil API ilə yenidən cəhd edilir...\e[0m"
    do_download --extractor-args "tiktok:app_info=/musical_ly/35.1.3/2023501030/0" -f 'bestvideo*+bestaudio/best' --merge-output-format mp4
    return $?
  fi
  return 1
}

case "$platform" in
  instagram|tiktok|facebook|x)
    echo -e "\e[036m Platforma: ${platform^^} — avtomatik ən yüksək keyfiyyət yüklənir...\e[0m"
    if auto_download; then
      exit_termux
    else
      show_error_hint "$platform"
      wait_and_keep_open
    fi
    ;;
esac

# YouTube və digər platformalar — dinamik real keyfiyyət siyahısı
meta="$(meta_info)"
if [ -z "$meta" ]; then
  echo -e "\e[031m[!] Xəta: Bu linkdən media məlumatı alına bilmədi — link düzgün deyil, silinib,\e[0m"
  echo -e "\e[031m    privatdır və ya platforma giriş (login) tələb edir.\e[0m"
  if [ -s "$tmp_dir/.meta_err" ]; then
    echo -e "\e[033m[Yt-dlp mesajı:]\e[0m"
    sed 's/\x1b\[[0-9;]*m//g' "$tmp_dir/.meta_err" | tail -4
    echo -e "\e[0m"
  fi
  rm -f "$tmp_dir/.meta_err"
  wait_and_keep_open
fi
rm -f "$tmp_dir/.meta_err"

title="$(printf '%s\n' "$meta" | sed -n '1p')"
[ -z "$title" ] && title="Bilinməyən başlıq"
heights_csv="$(printf '%s\n' "$meta" | sed -n '2p')"
IFS=',' read -r -a heights <<< "$heights_csv"
if [ "${#heights[@]}" -eq 0 ]; then
  # Direkt fayl/məlumat yoxdursa (məs. birbaşa .mp4 linki) — "ən yaxşı MP4" seçimi
  has_fallback=1
  mp3_num=2
else
  has_fallback=0
  mp3_num=$(( ${#heights[@]} + 1 ))
fi
total="$mp3_num"

