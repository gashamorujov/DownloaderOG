#!/data/data/com.termux/files/usr/bin/bash

# GASHAM DOWNLOADEROG
# Termux üçün universal media yükləyici (YouTube, TikTok, Instagram, ...)
# İşləmə məntiqi: Paylaş (Share) → Termux → Menyu → Yükləmə (cut)

# SETTINGS (istədiyiniz kimi dəyişə bilərsiniz)--------------
final_dir='/storage/emulated/0/DownloaderOG'
tmp_dir="$HOME/.cache/downloaderog"
# -----------------------------------------------------------

scan_media() {
  if command -v termux-media-scan >/dev/null 2>&1; then
    termux-media-scan "$1" >/dev/null 2>&1
    echo -e "\e[036m[✓] MediaScanner: $(basename "$1") qeydiyyata alındı (Qalereya/pleyer)\e[0m"
  else
    echo -e "\e[033m[!] Media qeydiyyatı üçün termux-api quraşdırın: pkg install termux-api\e[0m"
  fi
}

exit_termux() {
  echo -e "\e[036m Yükləmə tamamlandı — Termux bağlanır...\e[0m"
  sleep 2
  if command -v am >/dev/null 2>&1; then
    am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
    am force-stop com.termux >/dev/null 2>&1
  fi
  exit 0
}

do_download() {
  mkdir -p "$tmp_dir" "$final_dir"
  yt-dlp "$@" -o "$tmp_dir/%(title)s.%(ext)s" "$url"
  status=$?
  rm -f "$tmp_dir"/*.part 2>/dev/null
  if [ "$status" -ne 0 ]; then
    echo -e "\e[031m[!] Yükləmə xətası — heç bir fayl tamamlanmadı.\e[0m"
    return "$status"
  fi
  moved=""
  for f in "$tmp_dir"/*; do
    [ -e "$f" ] || continue
    name="$(basename "$f")"
    mv -f "$f" "$final_dir/"
    moved="$name"
  done
  if [ -n "$moved" ]; then
    echo -e "\e[032m[✓] Fayl kəsildi (cut): $final_dir/$moved\e[0m"
    scan_media "$final_dir/$moved"
  fi
}

url="$1"
if [[ -z "$url" ]]; then
  printf "\e[033m Video/audio linkini daxil edin: \e[0m"
  read -r url
fi
if [[ -z "$url" ]]; then
  echo -e "\e[031m Link daxil edilməyib. Çıxılır.\e[0m"
  exit 1
fi

# YouTube Shorts — avtomatik yükləmə (menyu göstərilmir)
if [[ "$url" == *"shorts"* ]]; then
  echo -e "\e[036m Short aşkarlandı — avtomatik yüklənir...\e[0m"
  do_download
  exit_termux
fi

