  echo -e "\e[036m╔════════════════════════════════════════════════════════════╗"
  echo -e "\e[032m║ ♚ Project Name : DownloaderOG™                           ║"
  echo -e "\e[032m║ ♚ Author       : Gasham Orujov                            ║"
  echo -e "\e[036m╠════════════════════════════════════════════════════════════╝"
  echo -e "\e[032m Başlıq: $title"
  echo -e "\e[036m╠═▶ [ SELECT A FORMAT ] ➳"
  local num=0
  if [ "${#heights[@]}" -gt 0 ]; then
    echo -e "\e[036m MP4"
